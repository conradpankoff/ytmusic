{
  "manifest_version": 3,
  "name": "YouTube URL Poster",
  "version": "1.2",
  "description": "Send YouTube video URLs to a configured API endpoint.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/watch*"],
      "js": ["content.js"]
    }
  ],
  "commands": {
    "send_youtube_url": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Send current YouTube URL to API"
    }
  },
  "options_page": "options.html"
}
